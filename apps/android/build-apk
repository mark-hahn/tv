#!/bin/bash
# Build APK on hahnca.com and install on connected device
# Usage: ./build-apk [device-serial]
set -e

DEVICE=${1:-56221JEBF01987}
REMOTE=hahnca.com
BUILD_DIR=/tmp/android-build
APK_PATH=$BUILD_DIR/android/app/build/outputs/apk/release/app-release.apk
LOCAL_APK=/root/apps/tv/build.apk
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_FILE="$SCRIPT_DIR/.build-cache"

PHASE_FILE=/root/apps/tv/build-phase

do_install() {
  local device=$1
  local apk=$2
  echo "==> Installing on device $device..."
  if ! timeout 600 adb -s "$device" install -r "$apk" 2>&1; then
    echo "==> Install failed — uninstalling old version and retrying..."
    adb -s "$device" uninstall com.hahnca.tvremote 2>/dev/null || true
    sleep 2
    timeout 600 adb -s "$device" install "$apk" 2>&1 || {
      echo "==> Install failed after uninstall+reinstall."
      return 1
    }
  fi
  return 0
}

CHECKSUM=$(md5sum "$SCRIPT_DIR/App.js" "$SCRIPT_DIR/app.json" "$SCRIPT_DIR/package.json" "$SCRIPT_DIR/babel.config.js" "$SCRIPT_DIR/eas.json" "$SCRIPT_DIR/index.js" | md5sum | cut -d' ' -f1)
CACHED_CHECKSUM=$(cut -d' ' -f1 "$CACHE_FILE" 2>/dev/null || echo "")
CACHED_APK=$(cut -d' ' -f2 "$CACHE_FILE" 2>/dev/null || echo "")

if [[ "$CHECKSUM" == "$CACHED_CHECKSUM" && -n "$CACHED_APK" ]]; then
  echo "==> Checksum matches cache — skipping build."
  echo "downloading" > "$PHASE_FILE"
  if [[ "$CACHED_APK" == gradle:* ]]; then
    echo "==> Downloading cached APK from server..."
    scp "$REMOTE:${CACHED_APK#gradle:}" "$LOCAL_APK"
  else
    echo "==> Downloading cached APK from URL..."
    curl -L "$CACHED_APK" -o "$LOCAL_APK"
  fi
  echo "installing" > "$PHASE_FILE"
  do_install "$DEVICE" "$LOCAL_APK" || exit 1
  rm -f "$PHASE_FILE"
  echo "==> Done (from cache)."
  exit 0
fi

echo "syncing" > "$PHASE_FILE"
echo "==> Syncing project to server..."
rsync -a --delete \
  --exclude node_modules \
  --exclude .git \
  --exclude android/build \
  --exclude android/.gradle \
  --exclude android/app/.cxx \
  /root/apps/tv/apps/android/ $REMOTE:$BUILD_DIR/

echo "npm" > "$PHASE_FILE"
echo "==> Installing npm deps..."
ssh $REMOTE "cd $BUILD_DIR && npm install --legacy-peer-deps 2>&1 | tail -3"

echo "building" > "$PHASE_FILE"
echo "==> Building APK..."
ssh $REMOTE "
  export ANDROID_HOME=/opt/android-sdk
  export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
  cd $BUILD_DIR/android
  ./gradlew assembleRelease --console=plain 2>&1 | grep --line-buffered -E 'Task :app:|BUILD|FAIL|error'
"

echo "downloading" > "$PHASE_FILE"
echo "==> Downloading APK..."
scp $REMOTE:$APK_PATH $LOCAL_APK

echo "installing" > "$PHASE_FILE"
do_install "$DEVICE" "$LOCAL_APK" || exit 1

echo "$CHECKSUM gradle:$APK_PATH" > "$CACHE_FILE"
rm -f "$PHASE_FILE"
echo "==> Done."
