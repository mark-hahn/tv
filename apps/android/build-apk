#!/bin/bash
# Build APK on hahnca.com and install on connected device
# Usage: ./build-apk [device-serial]
set -e

DEVICE=${1:-56221JEBF01987}
REMOTE=hahnca.com
BUILD_DIR=/tmp/android-build
APK_PATH=$BUILD_DIR/android/app/build/outputs/apk/release/app-release.apk
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CACHE_FILE="$SCRIPT_DIR/.build-cache"
# The apk goes to the phone over wifi from the server, never over the usb
# cable: the usb/ip link into wsl stalls on anything bigger than a few hundred
# KB, while small adb commands over it are fine. So usb is used only to read
# the phone's address and switch its adb onto tcp; the server, which is wired,
# connects to that and streams the install. The server's adb trusts the phone
# with this wsl's own adb key, kept there as a vendor key, so the phone never
# has to be re-authorized for it.
WIFI_ADB_PORT=5555
REMOTE_VENDOR_KEY=/root/.android/wsl-adbkey
PACKAGE=com.hahnca.tvremote
USB_REAPPEAR_WAIT_S=20

PHASE_FILE=/root/apps/tv/build-phase

# Puts the phone's adb back on usb and waits for it to show up here again.
# Re-enumerating on the phone's side drops the usb/ip attachment, so if it
# has not come back by itself it is re-attached.
restore_usb() {
  local device=$1
  local wifi=$2
  ssh $REMOTE "adb -s $wifi usb >/dev/null 2>&1; sleep 2; adb disconnect $wifi >/dev/null 2>&1" || true
  local until=$((SECONDS + USB_REAPPEAR_WAIT_S))
  while (( SECONDS < until )); do
    if adb devices | grep -q "^$device[[:space:]]*device"; then return 0; fi
    sleep 2
  done
  echo "==> $device did not come back on usb -- re-attaching via usbipd..."
  local busid
  busid=$(powershell.exe -Command "usbipd list" 2>/dev/null | tr -d '\r' | awk '/Shared/{print $1; exit}')
  if [[ -n "$busid" ]]; then
    powershell.exe -Command "usbipd attach --wsl --busid $busid" >/dev/null 2>&1 || true
    sleep 5
  fi
  adb devices | grep -q "^$device[[:space:]]*device" || echo "==> $device is still not on usb"
}

do_install() {
  local device=$1
  local apk=$2
  local ip
  ip=$(adb -s "$device" shell ip -4 addr show wlan0 2>/dev/null | grep -o 'inet [0-9.]*' | cut -d' ' -f2)
  if [[ -z "$ip" ]]; then
    echo "==> Could not read the wifi address of $device."
    return 1
  fi
  local wifi=$ip:$WIFI_ADB_PORT
  echo "==> Switching $device to adb over wifi at $wifi..."
  adb -s "$device" tcpip $WIFI_ADB_PORT >/dev/null 2>&1
  sleep 3
  echo "==> Installing from server over wifi..."
  local ok=0
  ssh $REMOTE "
    ADB_VENDOR_KEYS=$REMOTE_VENDOR_KEY adb start-server >/dev/null 2>&1
    adb connect $wifi >/dev/null 2>&1; sleep 2
    if ! adb devices | grep -q '^$wifi[[:space:]]*device'; then
      # a server started without the vendor key cannot authenticate to the phone
      adb kill-server >/dev/null 2>&1
      ADB_VENDOR_KEYS=$REMOTE_VENDOR_KEY adb start-server >/dev/null 2>&1
      adb connect $wifi >/dev/null 2>&1; sleep 2
    fi
    if ! adb devices | grep -q '^$wifi[[:space:]]*device'; then
      echo '==> Server could not connect to the phone over wifi:'; adb devices; exit 1
    fi
    if ! adb -s $wifi install -r $apk 2>&1; then
      echo '==> Install failed -- uninstalling old version and retrying...'
      adb -s $wifi uninstall $PACKAGE >/dev/null 2>&1 || true
      sleep 2
      adb -s $wifi install $apk 2>&1 || { echo '==> Install failed after uninstall+reinstall.'; exit 1; }
    fi
  " && ok=1
  restore_usb "$device" "$wifi"
  (( ok )) || return 1
  return 0
}

CHECKSUM=$(md5sum "$SCRIPT_DIR/App.js" "$SCRIPT_DIR/app.json" "$SCRIPT_DIR/package.json" "$SCRIPT_DIR/babel.config.js" "$SCRIPT_DIR/eas.json" "$SCRIPT_DIR/index.js" "$SCRIPT_DIR/services.json" "$SCRIPT_DIR/keyLabels.js" | md5sum | cut -d' ' -f1)
CACHED_CHECKSUM=$(cut -d' ' -f1 "$CACHE_FILE" 2>/dev/null || echo "")
CACHED_APK=$(cut -d' ' -f2 "$CACHE_FILE" 2>/dev/null || echo "")

if [[ "$CHECKSUM" == "$CACHED_CHECKSUM" && -n "$CACHED_APK" ]]; then
  echo "==> Checksum matches cache — skipping build."
  if [[ "$CACHED_APK" != gradle:* ]]; then
    echo "==> Cached apk is not a server build ($CACHED_APK); delete $CACHE_FILE and rebuild."
    exit 1
  fi
  echo "installing" > "$PHASE_FILE"
  do_install "$DEVICE" "${CACHED_APK#gradle:}" || exit 1
  rm -f "$PHASE_FILE"
  echo "==> Done (from cache)."
  exit 0
fi

echo "syncing" > "$PHASE_FILE"
echo "==> Syncing project to server..."
rsync -a --delete \
  --exclude node_modules \
  --exclude .git \
  --exclude android/build \
  --exclude android/.gradle \
  --exclude android/app/.cxx \
  /root/apps/tv/apps/android/ $REMOTE:$BUILD_DIR/

echo "npm" > "$PHASE_FILE"
# A dependency change gets a clean install from the lock file: a plain npm
# install has left packages half-present after a major upgrade, and the
# native modules' build intermediates live in node_modules, so the clean
# install (and the full native recompile it forces) is saved for when the
# lock file actually changed. Its checksum is kept on the server next to the
# tree it was installed into.
LOCK_SUM=$(md5sum "$SCRIPT_DIR/package-lock.json" | cut -d' ' -f1)
ssh $REMOTE "
  cd $BUILD_DIR
  if [[ \"\$(cat .lock-sum 2>/dev/null)\" == \"$LOCK_SUM\" ]]; then
    echo '==> Installing npm deps...'
    npm install --legacy-peer-deps 2>&1 | tail -3
  else
    echo '==> Lock file changed -- clean npm install...'
    rm -rf node_modules
    npm ci --legacy-peer-deps 2>&1 | tail -3 && echo '$LOCK_SUM' > .lock-sum
  fi
"

echo "building" > "$PHASE_FILE"
echo "==> Building APK..."
# Expo caches the autolinked native-module list under these two directories
# and reuses it across builds, so a list generated against a broken or older
# node_modules would silently leave modules out of the app. Regenerating it
# costs seconds.
ssh $REMOTE "
  export ANDROID_HOME=/opt/android-sdk
  export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
  cd $BUILD_DIR/android
  rm -rf build/generated/autolinking app/build/generated/autolinking
  ./gradlew assembleRelease --console=plain 2>&1 | grep --line-buffered -E 'Task :app:|BUILD|FAIL|error'
"

# cache the build before installing, so a failed install doesn't force a rebuild
echo "$CHECKSUM gradle:$APK_PATH" > "$CACHE_FILE"

echo "installing" > "$PHASE_FILE"
do_install "$DEVICE" "$APK_PATH" || exit 1

rm -f "$PHASE_FILE"
echo "==> Done."
