#!/bin/bash
# Connect hahnca.com's adb to the Android TV and cache the serial in .device.
#
#   ./connect-tv           # connect (IP and port discovered over mDNS)
#   ./connect-tv 451710    # re-pair with the code shown on the TV, then connect
#
# The TV's IP *and* its wireless debugging port both change across a reboot, so
# nothing about the address is hard-wired: the TV advertises both over mDNS,
# which is what gets looked up. Pairing itself survives reboots — the code form
# is only needed after "Revoke pairings" or if the TV forgets us.
set -e

REMOTE=hahnca.com
# Stable per-device id from the mDNS service name, so other Android devices on
# the LAN can't be picked by mistake. A factory reset changes it; if it stops
# matching, the first advertised device is used instead.
TV_GUID=adb-126371003034247B0000B51C53A-aoJzeA
CONNECT_SVC=_adb-tls-connect._tcp
PAIRING_SVC=_adb-tls-pairing._tcp
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DEVICE_FILE="$SCRIPT_DIR/.device"

PAIR_CODE=$1
CACHED=$(cat "$DEVICE_FILE" 2>/dev/null || echo "")

# One remote shell for the whole job: adb and avahi both live on the server.
# fd 3 carries the answer, everything else is progress output on stderr.
DEVICE=$(ssh $REMOTE bash -s <<EOF || true
  exec 3>&1 1>&2
  set -u

  # Resolve an mDNS service type to "ip:port", preferring our own device.
  find_svc() {
    local svc=\$1 out
    out=\$(timeout 10 avahi-browse -rtp "\$svc" 2>/dev/null |
      awk -F';' '\$1 == "=" && \$3 == "IPv4" { print \$4 " " \$8 ":" \$9 }')
    [[ -z "\$out" ]] && return 1
    { grep -m1 "^$TV_GUID " <<<"\$out" || head -1 <<<"\$out"; } | cut -d' ' -f2
  }

  connect() {
    adb connect "\$1" >/dev/null 2>&1 || true
    if adb -s "\$1" shell true >/dev/null 2>&1; then
      echo "\$1" >&3
      return 0
    fi
    adb disconnect "\$1" >/dev/null 2>&1 || true
    return 1
  }

  if [[ -n "$PAIR_CODE" ]]; then
    echo "==> Looking for the pairing service..."
    pair_addr=\$(find_svc $PAIRING_SVC) || {
      echo "==> No pairing service advertised — the 'Pair device with pairing"
      echo "==> code' dialog has to be open on the TV while this runs."
      exit 1
    }
    echo "==> Pairing with \$pair_addr..."
    adb pair "\$pair_addr" "$PAIR_CODE" || exit 1
  elif [[ -n "$CACHED" ]] && connect "$CACHED"; then
    exit 0
  fi

  echo "==> Looking for the TV..."
  addr=\$(find_svc $CONNECT_SVC) || {
    echo "==> The TV is not advertising adb. Turn Wireless debugging back on:"
    echo "==>   Settings > System > Developer options > Wireless debugging"
    echo "==> (it switches itself off across a reboot)."
    exit 1
  }
  echo "==> Found \$addr"
  connect "\$addr" || {
    echo "==> \$addr refused us. If the TV shows an 'Allow debugging?' dialog,"
    echo "==> accept it and rerun; otherwise re-pair with:"
    echo "==>   ./connect-tv <pairing code>"
    exit 1
  }
EOF
)

[[ -z "$DEVICE" ]] && exit 1

echo "$DEVICE" > "$DEVICE_FILE"
echo "$DEVICE"
