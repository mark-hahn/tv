#!/usr/bin/env bash
# (Re)register the tv-watchdog pm2 task from ecosystem.config.cjs on the
# remote server. Normally not needed — ./srvr deploys reload it — only run
# this if pm2's process list was wiped.
cd /root/dev/apps/tv
pm2 delete tv-watchdog 2> /dev/null
pm2 start ecosystem.config.cjs --only tv-watchdog --env production
pm2 save
