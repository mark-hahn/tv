#!/usr/bin/env bash

# Deploy what is stale (./srvr --if-stale), then make sure the client's vite is running. A failed
# deploy is reported (a !! line, and a non-zero exit at the end) and vite starts anyway. A vite already running from this repo is left alone,
# so this can be run from a terminal at any time; RESTART_VITE=1 (the claude3 page's "v" prompt)
# stops it and starts a fresh one, which reloads the page. Arguments go to a newly started vite.
# If anything else holds vite's port, it shows an error and neither starts nor restarts vite.
# vite runs detached with its output in vite.log, so it outlives this script and whatever started
# it. The script waits for vite's ready line, prints the log so far, and exits.
VITE_PORT=5173 # vite's default; strictPort in vite.config.js stops it moving off this
trap 'echo; echo "====== ENDED ======"' EXIT # claude3's Run output ends on this line
# The unilog reconcile writes ids into the sources, so it runs before the deploy copies any. The
# line after it tells claude3 the stamp counts from there: what was written before it is deployed.
# Failing, it is left to each project's own reconcile in the deploy, and the stamp counts from the start.
if ./recon all; then
  echo "== sources frozen $(date +%s%3N)"
else
  echo "!! unilog reconcile failed; the deploy reconciles each project again"
fi
if ./srvr --if-stale; then
  # claude3's page warns before a prompt when files under these paths are newer than .deployed
  printf '%s\n' package.json pnpm-workspace.yaml turbo.json ecosystem.config.cjs packages/share \
    apps/api apps/srvr apps/asr apps/tv apps/watchdog apps/down apps/client > .deployed
  deploy_rc=0
else
  deploy_rc=$?
  echo "!! deploy failed (./srvr --if-stale exit $deploy_rc); vite is started anyway"
fi
log="$PWD/vite.log"
cd apps/client
vite="$PWD/node_modules/.bin/vite"
# What a running vite's command line shows: .bin/vite is pnpm's shim, which execs node on this.
running="$PWD/node_modules/.bin/../vite/bin/vite.js"
# Checked before anything stops vite. With a --port argument this port isn't needed.
holder=$(ss -ltnpH "sport = :$VITE_PORT" | grep -oP 'pid=\K[0-9]+' | head -1)
if [[ -n $holder && "$*" != *--port* ]] && ! pgrep -f "$running" | grep -qx "$holder"; then
  echo "!! port $VITE_PORT is in use by pid $holder ($(ps -o args= -p "$holder")); vite not started or restarted"
  exit 1
fi
if [[ $RESTART_VITE == 1 ]] && pkill -f "$running"; then
  for _ in {1..25}; do pgrep -f "$running" >/dev/null || break; sleep 0.2; done
fi
if pgrep -f "$running" >/dev/null; then
  echo "vite already running (hot update); left alone, output in vite.log"
  exit $deploy_rc
fi
: > "$log"
setsid nohup "$vite" "$@" > "$log" 2>&1 < /dev/null &
for _ in {1..100}; do
  grep -qE "Local:|rror" "$log" && break
  kill -0 $! 2>/dev/null || break
  sleep 0.2
done
cat "$log"
exit $deploy_rc

