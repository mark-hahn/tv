#!/usr/bin/env node

// Usage: ./seek2 <scrubInterval_secs> <scrubDist_secs>
//   Sequence per iteration:
//     pause → seek → pause → [scrubInterval] → (repeat)
//   scrubDist_secs: jump distance in seconds (negative = backward)

const TV_TV_URL = "https://hahnca.com/tv-tv";

const args = process.argv.slice(2);
if (args.length < 2) {
  console.error("Usage: ./seek2 <scrubInterval_secs> <scrubDist_secs>");
  console.error("  scrubInterval: pause after frame (still-frame hold time)");
  console.error(
    "  scrubDist:     jump distance in seconds (negative = backward)",
  );
  process.exit(1);
}
const d3ms = parseFloat(args[0]) * 1000;
const DIST_TICKS = parseFloat(args[1]) * 10_000_000;
console.log(`scrubInterval: ${args[0]}s`);
console.log(`scrubDist:     ${args[1]}s`);

const ts = () => {
  const d = new Date();
  const hh = String(d.getHours()).padStart(2, "0");
  const mm = String(d.getMinutes()).padStart(2, "0");
  const ss = String(d.getSeconds()).padStart(2, "0");
  const ms = String(d.getMilliseconds()).padStart(3, "0");
  return `${hh}:${mm}:${ss}.${ms}`;
};

const getPos = () =>
  fetch(`${TV_TV_URL}/tv/emby/position`)
    .then((r) => r.json())
    .catch(() => null);

// seek2: pause → [d1] → seek → [d2] → pause → [d3] → (repeat)
const seek2 = (ticks) =>
  fetch(`${TV_TV_URL}/tv/emby/seek2`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ ticks, d3ms }),
  })
    .then((r) => r.json())
    .catch(() => null);

process.on("SIGINT", () => {
  console.log("\nStopped.");
  process.exit(0);
});

(async () => {
  // --- SETUP: get initial position, show overlay ---
  const init = await getPos();
  if (!init?.ok) {
    console.error("Emby not playing");
    process.exit(1);
  }
  console.log(
    `${ts()} initial position: ${(init.ticks / 10000 / 1000).toFixed(2)}s`,
  );

  let pos = init.ticks;
  let i = 1;
  // eslint-disable-next-line no-constant-condition
  while (true) {
    const target = Math.max(0, pos + DIST_TICKS);
    console.log(`${ts()} seek2 #${i} → ${(target / 10000 / 1000).toFixed(2)}s`);
    const res = await seek2(target);
    console.log(`${ts()} result: ${JSON.stringify(res)}`);
    pos = target;
    i++;
  }
})();
