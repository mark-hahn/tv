#!/usr/bin/env node

// Test script: start server-side scrub, ping every 0.5s to keep alive
// Stop by pressing Ctrl+C — server stops scrubbing within 1s of last ping
// Usage: ./seek3 [intervalSecs] [distSecs]
//   intervalSecs — seconds between seeks (default 0.5)
//   distSecs     — seconds per seek, negative = backward (default 10)
const TV_TV_URL = "https://hahnca.com/tv-tv";
const INTERVAL_MS = Number(process.argv[2] ?? 0.5) * 1000;
const DIST_TICKS = Number(process.argv[3] ?? 10) * 10_000_000;

const ts = () => {
  const d = new Date();
  const hh = String(d.getHours()).padStart(2, "0");
  const mm = String(d.getMinutes()).padStart(2, "0");
  const ss = String(d.getSeconds()).padStart(2, "0");
  return `${hh}:${mm}:${ss}`;
};

const start = () =>
  fetch(`${TV_TV_URL}/tv/emby/scrub/start`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      intervalMs: INTERVAL_MS,
      distTicks: DIST_TICKS,
    }),
  })
    .then((r) => r.json())
    .catch((e) => ({ ok: false, error: e.message }));

(async () => {
  console.log(
    `${ts()} starting scrub (intervalMs=${INTERVAL_MS}, distTicks=${DIST_TICKS})...`,
  );
  const startRes = await start();
  console.log(`${ts()} start: ${JSON.stringify(startRes)}`);
  if (!startRes.ok) process.exit(1);

  console.log(
    `${ts()} scrubbing... (Ctrl+C to stop, server will stop within 1s)`,
  );
  setInterval(() => {
    fetch(`${TV_TV_URL}/tv/emby/scrub/ping`, { method: "POST" }).catch(
      () => {},
    );
  }, 500);
})();
