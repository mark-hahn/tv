#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SSH_HOST="hahnca.com"

TV_REMOTE_BASE="${TV_REMOTE_BASE:-/root/dev/apps/tv-dev}"

if [[ ! -d "$ROOT_DIR/apps" ]]; then
  echo "Error: expected layout under $ROOT_DIR (missing apps/)" >&2
  exit 1
fi

SSH_CONTROL_PATH="$HOME/.ssh/tv-srvr-$$"

cleanup_ssh() {
  # Closing master connection
  ssh -O exit -S "$SSH_CONTROL_PATH" "$SSH_HOST" 2>/dev/null || true
}
trap cleanup_ssh EXIT

# Start ControlMaster
# -M: master mode
# -N: no remote command (just forward/establish socket)
# -f: background
ssh -f -N -M -S "$SSH_CONTROL_PATH" "$SSH_HOST"

usage() {
  echo "Usage: $(basename "$0") [api|down|srvr|client|share|asr|all]" >&2
  echo "Env: TV_REMOTE_BASE (default: /root/dev/apps/tv on remote)" >&2
  exit 1
}

run_ssh() {
  local retries=5
  local count=0
  until ssh -S "$SSH_CONTROL_PATH" "$@"; do
    local exit_code=$?
    count=$((count + 1))
    if [ $count -lt $retries ]; then
      echo "[warn] ssh failed with $exit_code, retrying $count/$retries in 3s..." >&2
      sleep 3
    else
      return $exit_code
    fi
  done
}

run_rsync() {
  local retries=5
  local count=0
  until rsync -e "ssh -S '$SSH_CONTROL_PATH'" "$@"; do
    local exit_code=$?
    count=$((count + 1))
    if [ $count -lt $retries ]; then
      echo "[warn] rsync failed with $exit_code, retrying $count/$retries in 3s..." >&2
      sleep 3
    else
      return $exit_code
    fi
  done
}

pm2_name_for_project() {
  case "$1" in
    api)  printf '%s' "tv-api" ;;
    down) printf '%s' "tv-down" ;;
    srvr) printf '%s' "tv-srvr" ;;
    client) printf '%s' "tv-client" ;;
    share) printf '%s' "tv-share" ;;
    *) return 1 ;;
  esac
}

local_app_path_relative() {
  local project="$1"
  case "$project" in
    share) echo "packages/share" ;;
    *) echo "apps/$project" ;;
  esac
}

local_app_dir_for_project() {
  local project="$1"
  echo "$ROOT_DIR/$(local_app_path_relative "$project")"
}

remote_app_dir_for_project() {
  local project="$1"
  echo "$TV_REMOTE_BASE/$(local_app_path_relative "$project")"
}

sync_monorepo_root() {
  echo "[remote] sync root files -> $SSH_HOST:$TV_REMOTE_BASE/"
  run_ssh "$SSH_HOST" "mkdir -p '$TV_REMOTE_BASE/apps' '$TV_REMOTE_BASE/packages'"
  
  run_rsync -az \
    "$ROOT_DIR/package.json" \
    "$ROOT_DIR/pnpm-workspace.yaml" \
    "$ROOT_DIR/pnpm-lock.yaml" \
    "$ROOT_DIR/turbo.json" \
    "$ROOT_DIR/ecosystem.config.cjs" \
    "$ROOT_DIR/ecosystem.dev.config.cjs" \
    "$SSH_HOST:$TV_REMOTE_BASE/"
}

remote_sync_app() {
  local project="$1"
  local local_dir
  local remote_dir
  local_dir="$(local_app_dir_for_project "$project")"
  remote_dir="$(remote_app_dir_for_project "$project")"

  local -a extra_excludes=()
  if [[ "$project" == "api" || "$project" == "down" || "$project" == "srvr" || "$project" == "asr" ]]; then
    # Runtime state and credentials live here; never overwrite them during deploy.
    extra_excludes+=(--exclude 'data/')
    extra_excludes+=(--exclude 'secrets/')
  fi

  if [[ ! -d "$local_dir" ]]; then
    echo "Error: missing local app dir: $local_dir" >&2
    exit 1
  fi

  echo "[remote] rsync $project -> $SSH_HOST:$remote_dir"
  # Reset remote directory implies we create the parent structure
  # rsync will create the leaf directory because we use local_dir/
  # But we need to ensure the PARENT exists.
  # remote_app_dir_for_project returns full path.
  # dirname ensures apps/ or packages/ exists.
  run_ssh "$SSH_HOST" "mkdir -p '$(dirname "$remote_dir")'"

  run_rsync -az    \
    "${extra_excludes[@]}" \
    --exclude 'node_modules/' \
    --exclude '.turbo/' \
    --exclude 'dist/' \
    --exclude 'build/' \
    --exclude '.output/' \
    --exclude '.cache/' \
    --exclude '.vite/' \
    --exclude '.nuxt/' \
    --exclude '.next/' \
    --exclude '.svelte-kit/' \
    --exclude '.parcel-cache/' \
    --exclude 'data/' \
    --exclude 'secrets/' \
    --exclude 'reel-shows.json' \
    --exclude 'reelgood-titles.json' \
    --exclude 'reelgood.log' \
    --exclude 'calls.log' \
    --exclude 'package-lock.json' \
    --exclude 'yarn.lock' \
    "$local_dir" "$SSH_HOST:$(dirname "$remote_dir")/"
}

remote_install_app_deps() {
  local project="$1"
  
  # For client, we just sync (built locally), no remote install needed.
  if [[ "$project" == "client" ]]; then return 0; fi

  echo "[remote] pnpm install (workspace root)"
  # In true monorepo, we install at ROOT.
  # We assume 'share' is synced if it's needed.
  
  run_ssh "$SSH_HOST" "cd '$TV_REMOTE_BASE' \
    && if command -v pnpm >/dev/null 2>&1; then \
         pnpm install; \
         if [[ \"$project\" == \"down\" ]]; then pnpm rebuild better-sqlite3 --filter @tv/down; fi; \
       else echo 'pnpm not found on remote PATH' >&2; exit 1; fi"
}

remote_pm2_restart_all_silent() {
  echo "[remote] pm2 reload tv-dev apps..."
  run_ssh "$SSH_HOST" "cd '$TV_REMOTE_BASE' \
    && pm2 start ecosystem.dev.config.cjs --env production >/dev/null 2>&1 \
    && pm2 reload tv-api-dev tv-down-dev tv-srvr-dev >/dev/null 2>&1 \
    && pm2 save >/dev/null 2>&1"
}

remote_deploy_one_no_restart() {
  local project="$1"

  # Special handling for client build (local)
  if [[ "$project" == "client" ]]; then
    echo "[local] build: $project (vite)"
    if ! (cd "$(local_app_dir_for_project "$project")" && pnpm run build); then
      echo "Error: client build failed" >&2
      exit 1
    fi
  fi

  remote_sync_app "$project"

  # Client is static files only; no remote deps needed
  if [[ "$project" != "client" ]]; then
    remote_install_app_deps "$project"
  fi
}

case "${1:-all}" in
  api|down|srvr|client|share|asr)
    sync_monorepo_root
    remote_deploy_one_no_restart "$1"
    remote_pm2_restart_all_silent
    ;;
  all|"" )
    sync_monorepo_root
    remote_deploy_one_no_restart api
    remote_deploy_one_no_restart srvr
    # Legacy flat deploy mode compabitility (share) - ensures packages are present
    remote_deploy_one_no_restart share
    remote_deploy_one_no_restart asr
    
    if ! remote_deploy_one_no_restart down; then
      echo "[warn] down deploy failed; api/srvr already deployed" >&2
    fi
    
    remote_deploy_one_no_restart client
    
    remote_pm2_restart_all_silent
    ;;
  *)
    usage
    ;;
esac
