#!/usr/bin/env node
// ./uni — unilog CLI viewer
// Usage: ./uni [groups] [sites] [events] [<param>]
// Actions can be combined. If the last argument is not an action word it is
// treated as a parameter for future actions that need one (none yet).

import { spawnSync } from "node:child_process";

const SSH_HOST = "hahnca.com";
const DB = "/root/dev/apps/tv/unilog/unilog.sqlite";
const ACTIONS = new Set(["groups", "sites", "events"]);

const argv = process.argv.slice(2);
if (argv.length === 0) {
  console.log("usage: ./uni [groups] [sites] [events]");
  process.exit(0);
}

const lastIsParam = argv.length > 0 && !ACTIONS.has(argv[argv.length - 1]);
const param = lastIsParam ? argv[argv.length - 1] : null; // reserved for future use
const actionWords = (lastIsParam ? argv.slice(0, -1) : argv).filter((a) =>
  ACTIONS.has(a),
);

if (actionWords.length === 0) {
  console.error("no recognized actions — use: groups, sites, events");
  process.exit(1);
}

function query(sql, { tolerateError = false } = {}) {
  const r = spawnSync("ssh", [SSH_HOST, `sqlite3 -json ${DB}`], {
    input: sql,
    encoding: "utf8",
    timeout: 10000,
  });
  if (r.status !== 0) {
    if (tolerateError) return null;
    console.error((r.stderr || "").trim() || "ssh/sqlite3 failed");
    process.exit(1);
  }
  const out = (r.stdout || "").trim();
  return out ? JSON.parse(out) : [];
}

function printTable(rows, cols) {
  if (rows.length === 0) {
    console.log("  (none)");
    return;
  }
  const MAX_MSG = 80;
  const widths = cols.map(([hdr]) => hdr.length);
  for (const row of rows) {
    cols.forEach(([, key, fmt], i) => {
      let v = fmt ? fmt(row[key]) : String(row[key] ?? "");
      if (key === "message" && v.length > MAX_MSG)
        v = v.slice(0, MAX_MSG - 1) + "…";
      if (v.length > widths[i]) widths[i] = v.length;
    });
  }
  console.log(cols.map(([hdr], i) => hdr.padEnd(widths[i])).join("  "));
  console.log(cols.map((_, i) => "-".repeat(widths[i])).join("  "));
  const last = cols.length - 1;
  for (const row of rows) {
    console.log(
      cols
        .map(([, key, fmt], i) => {
          let v = fmt ? fmt(row[key]) : String(row[key] ?? "");
          if (key === "message" && v.length > MAX_MSG)
            v = v.slice(0, MAX_MSG - 1) + "…";
          return i === last ? v : v.padEnd(widths[i]);
        })
        .join("  "),
    );
  }
}

for (const action of actionWords) {
  if (action === "groups") {
    console.log("=== groups ===");
    const rows = query(
      "SELECT group_id, hide, description FROM log_groups ORDER BY group_id;",
    );
    printTable(rows, [
      ["id", "group_id"],
      ["hide", "hide"],
      ["description", "description"],
    ]);
    console.log();
  }

  if (action === "sites") {
    console.log("=== sites ===");
    const rows = query(
      "SELECT log_id, project, src_file, src_line, level, tag, removed_at FROM log_sites ORDER BY log_id;",
    );
    const hasRemoved = rows.some((r) => r.removed_at != null);
    const colDefs = [
      ["id", "log_id"],
      ["project", "project"],
      ["src_file", "src_file"],
      ["line", "src_line"],
      ["level", "level"],
      ["tag", "tag"],
    ];
    if (hasRemoved) colDefs.push(["removed", "removed_at"]);
    printTable(rows, colDefs);
    console.log();
  }
}

// events tails — runs last, keeps process alive with setInterval.
if (actionWords.includes("events")) {
  const MAX_MSG = 80;
  const EVENT_COLS = [
    ["ts", "ts", (v) => String(v ?? "").slice(-8)],
    ["message", "message"],
    ["id", "log_id"],
    ["tag", "tag"],
    ["project", "project"],
    ["src_file", "src_file"],
    ["line", "src_line"],
  ];
  const POLL_MS = 2000;
  const INITIAL_ROWS = 50;

  function fetchEvents(afterId, limit) {
    const where = afterId != null ? `WHERE e.id > ${Number(afterId)}` : "";
    const lim = limit != null ? `LIMIT ${Number(limit)}` : "";
    return query(
      `SELECT e.id, e.ts, e.log_id, s.tag, s.project, s.src_file, s.src_line,
              e.message
       FROM log_events e
       LEFT JOIN log_sites s ON s.log_id = e.log_id
       ${where}
       ORDER BY e.id DESC ${lim};`,
      { tolerateError: true },
    );
  }

  // Initial load — last INITIAL_ROWS events (descending then re-sorted asc).
  const initialDesc = fetchEvents(null, INITIAL_ROWS) || [];
  const initial = initialDesc.slice().reverse();
  if (initial.length > 0) printTable(initial, EVENT_COLS);
  else console.log("(no events yet — tailing…)");

  // Track column widths so appended rows align with the initial table.
  const widths = EVENT_COLS.map(([hdr]) => hdr.length);
  for (const row of initial) {
    EVENT_COLS.forEach(([, key, fmt], i) => {
      let v = fmt ? fmt(row[key]) : String(row[key] ?? "");
      if (key === "message" && v.length > MAX_MSG)
        v = v.slice(0, MAX_MSG - 1) + "…";
      if (v.length > widths[i]) widths[i] = v.length;
    });
  }

  let lastId = initial.length > 0 ? initial[initial.length - 1].id : 0;

  const lastCol = EVENT_COLS.length - 1;

  function printRow(row) {
    console.log(
      EVENT_COLS.map(([, key, fmt], i) => {
        let v = fmt ? fmt(row[key]) : String(row[key] ?? "");
        if (key === "message" && v.length > MAX_MSG)
          v = v.slice(0, MAX_MSG - 1) + "…";
        return i === lastCol ? v : v.padEnd(widths[i]);
      }).join("  "),
    );
  }

  const poll = () => {
    const rows = fetchEvents(lastId, null);
    if (rows && rows.length > 0) {
      // fetchEvents returns DESC when given a limit; for polling we get all new
      // rows ascending — re-reverse since afterId+DESC gives newest-first.
      const asc = rows.slice().reverse();
      for (const row of asc) printRow(row);
      lastId = asc[asc.length - 1].id;
    }
    setTimeout(poll, POLL_MS);
  };
  setTimeout(poll, POLL_MS);
}
